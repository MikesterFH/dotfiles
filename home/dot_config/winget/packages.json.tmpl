{{- /* winget import manifest for the current Profile, rendered from
       .chezmoidata/applications.toml (docs/adr/0006-application-category-and-profile-manifests.md,
       docs/adr/0023-applications-from-one-data-file.md): one package entry
       per Application with a `winget` field, in file order. Why an
       Application has none (psmux stands in for tmux, the VS Build Tools are
       installed by run_onchange_after_install-windows-applications.ps1.tmpl
       itself, mise installs it) is noted next to it in the data file.
       Installed via run_onchange_after_install-windows-applications.ps1.tmpl.
       CreationDate is a fixed placeholder, not the actual render time, so
       this file doesn't change on every `chezmoi apply` just from a
       timestamp — only the Application list changing should touch it. */ -}}
{{- $packages := list -}}
{{- range includeTemplate "applications.json" . | fromJson -}}
{{-   if hasKey . "winget" -}}
{{-     $packages = append $packages (dict "PackageIdentifier" .winget) -}}
{{-   end -}}
{{- end -}}
{{- $manifest := dict
      "$schema" "https://aka.ms/winget-packages.schema.2.0.json"
      "CreationDate" "1970-01-01T00:00:00.000-00:00"
      "Sources" (list (dict
          "Packages" $packages
          "SourceDetails" (dict
              "Argument" "https://cdn.winget.microsoft.com/cache"
              "Identifier" "Microsoft.Winget.Source_8wekyb3d8bbwe"
              "Name" "winget"
              "Type" "Microsoft.PreIndexed.Package"
          )
      ))
      "WinGetVersion" "1.0.0"
-}}
{{ $manifest | toPrettyJson }}
