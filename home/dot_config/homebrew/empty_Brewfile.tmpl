{{- /* Homebrew Bundle manifest for the current Profile's Application list
       (see docs/adr/0006-application-category-and-profile-manifests.md).
       One `brew` (CLI tool) or `cask` (GUI app) line per app in
       .applications that has a macOS identifier; apps with no macOS
       packaging (e.g. windows-terminal) are simply absent — same convention
       already used for GUI configs limited to one platform. Each app is
       assigned to exactly one Homebrew identifier here, decided when the
       app was added — no runtime fallback between formula/cask. unzip, zsh,
       file and build-tools (cc, make) have no entry: macOS ships the first
       three, and the Xcode Command Line Tools that Homebrew's own install
       requires bring the compiler. neovim and tree-sitter-cli have no entry either: they
       come from mise, pinned, on every OS, see
       docs/adr/0013-neovim-pinned-via-mise.md. Installed
       via run_onchange_after_install-macos-applications.sh.tmpl. */ -}}
{{- $homebrewFormulae := dict
      "delta" "git-delta"
      "starship" "starship"
      "tmux" "tmux"
      "fzf" "fzf"
      "zoxide" "zoxide"
      "yazi" "yazi"
      "glow" "glow"
      "bat" "bat"
      "lazygit" "lazygit"
      "ripgrep" "ripgrep"
      "fd" "fd"
      "cmake" "cmake"
      "eza" "eza"
      "7zip" "sevenzip"
      "imagemagick" "imagemagick"
      "poppler" "poppler"
      "resvg" "resvg"
      "jq" "jq"
      "ffmpeg" "ffmpeg"
      "uv" "uv"
      "helix" "helix"
      "hunk" "hunk"
-}}
{{- $homebrewCasks := dict
      "wezterm" "wezterm"
      "vscode" "visual-studio-code"
      "zed" "zed"
      "iterm2" "iterm2"
      "jetbrains-mono-nerd-font" "font-jetbrains-mono-nerd-font"
      "zen" "zen"
-}}
{{- $lines := list -}}
{{- range .applications -}}
{{- if hasKey $homebrewFormulae . -}}
{{- $lines = append $lines (printf "brew %q" (index $homebrewFormulae .)) -}}
{{- else if hasKey $homebrewCasks . -}}
{{- $lines = append $lines (printf "cask %q" (index $homebrewCasks .)) -}}
{{- end -}}
{{- end -}}
{{ $lines | join "\n" }}
