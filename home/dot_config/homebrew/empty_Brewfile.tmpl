{{- /* Homebrew Bundle manifest for the current Profile, rendered from
       .chezmoidata/applications.toml (docs/adr/0006-application-category-and-profile-manifests.md,
       docs/adr/0023-applications-from-one-data-file.md): one `brew` line per
       Application with a formula in its `brew` field, one `cask` line per
       `cask:` entry, in file order. Why an Application has no Homebrew entry
       (macOS ships it, mise installs it) is noted next to it in the data
       file. Installed via run_onchange_after_install-macos-applications.sh.tmpl. */ -}}
{{- $apps := includeTemplate "applications.json" . | fromJson -}}
{{- /* Third-party taps first, each trusted for exactly the cask the
       Brewfile pulls from it (Homebrew refuses to load untrusted tap
       content), see docs/adr/0018-aerospace-and-trusted-taps.md. */ -}}
{{- $lines := list -}}
{{- range $apps -}}
{{-   if and (hasKey . "brew_tap") (hasKey . "brew") -}}
{{-     $lines = append $lines (printf "tap %q, trusted: { casks: [%q] }" .brew_tap (.brew | splitList "/" | last)) -}}
{{-   end -}}
{{- end -}}
{{- range $apps -}}
{{-   if and (hasKey . "brew") (not (hasPrefix "cask:" .brew)) -}}
{{-     $lines = append $lines (printf "brew %q" .brew) -}}
{{-   else if hasKey . "brew" -}}
{{-     $lines = append $lines (printf "cask %q" (trimPrefix "cask:" .brew)) -}}
{{-   end -}}
{{- end -}}
{{ $lines | join "\n" }}
