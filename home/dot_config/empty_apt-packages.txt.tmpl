{{- /* apt package list for the current Profile, rendered from
       .chezmoidata/applications.toml (docs/adr/0006-application-category-and-profile-manifests.md,
       docs/adr/0023-applications-from-one-data-file.md): one package name
       per line for each Application with an `apt` field, in file order. The
       CLI tools mise installs on Linux have none (ADR 0012). A name missing
       from an older release is skipped and reported by the install script
       instead of failing (ADR 0008). Installed via
       run_onchange_after_install-linux-applications.sh.tmpl. Debian/apt
       only: this file doesn't render on Fedora/Arch/other Linux distros, or
       on macOS/Windows, see .chezmoiignore. */ -}}
{{- $lines := list -}}
{{- range includeTemplate "applications.json" . | fromJson -}}
{{-   if hasKey . "apt" -}}
{{-     $lines = append $lines .apt -}}
{{-   end -}}
{{- end -}}
{{ $lines | join "\n" }}
