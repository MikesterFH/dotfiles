# Per-OS paths, one switch on .chezmoi.os for everything that differs by
# Target: vscode's settings live at a different real path per OS (macOS:
# Library/, Linux: .config/Code, Windows: AppData); the iTerm2 Dynamic
# Profile (Library/) and PowerShell profile (Documents/) are single-OS only;
# zed and helix live at .config/<app> everywhere except Windows
# (AppData/Roaming/Zed, AppData/Roaming/helix);
# the macOS Application manifest (.config/homebrew), the Linux Application
# manifest (.config/apt-packages.txt, further narrowed to Debian/apt below),
# and the Windows Application manifest (.config/winget — see
# docs/adr/0006-application-category-and-profile-manifests.md) are each
# single-OS; and the Windows Target has no bash/zsh of its own. tmux IS
# deployed on Windows (.config/tmux is not excluded there) — psmux reads the
# same tmux.conf, see docs/adr/0005-psmux-for-windows-tmux-parity.md.
# Every branch lists everything *not* relevant to that OS, so an unlisted
# fifth OS falls through to the catch-all and excludes all of it — fail
# safe, not a guess.
{{ if eq .chezmoi.os "darwin" }}
.psmux.conf
.config/Code
AppData
Documents
.config/apt-packages.txt
.config/winget
{{ else if eq .chezmoi.os "linux" }}
.psmux.conf
Library
AppData
Documents
.config/homebrew
.config/winget
{{ else if eq .chezmoi.os "windows" }}
Library
.config/Code
.bashrc
.bash_aliases
.zshrc
.zprofile
.zsh_aliases
.config/zed
.config/helix
.local
.config/homebrew
.config/apt-packages.txt
{{ else }}
.psmux.conf
Library
.config/Code
AppData
Documents
.config/homebrew
.config/apt-packages.txt
.config/winget
{{ end }}

# Linux Application manifest (apt, Debian only, see
# docs/adr/0006-application-category-and-profile-manifests.md): the OS
# switch above only excludes it on non-Linux Targets; within Linux, it's
# further narrowed to Debian-family distros, matching the Bootstrap
# script's own detect_linux_distro categorization (debian/ubuntu/pop/
# linuxmint/elementary) — no Fedora/Arch Application manifest.
{{ $debianLikeIDs := list "debian" "ubuntu" "pop" "linuxmint" "elementary" }}
{{ if and (eq .chezmoi.os "linux") (not (has .chezmoi.osRelease.id $debianLikeIDs)) }}
.config/apt-packages.txt
{{ end }}

# Machine Profile (chezmoi init --promptChoiceOnce profile=personal|dev|dev-server,
# see docs/adr/0004-machine-profiles.md): narrows which git identity
# config.local.* files exist to match which [data.git.*] tables
# .chezmoi.toml.tmpl actually populated for the chosen profile — dev never
# gets a personal identity, only dev gets a client identity. work is
# generated on every profile, so it's never excluded here.
{{ if eq .profile "dev" }}
.config/git/config.local.personal
{{ else }}
.config/git/config.local.client
{{ end }}

# GUI-app configs (per-Profile Application list, see .chezmoi.toml.tmpl and
# docs/adr/0006-application-category-and-profile-manifests.md): each app's
# config is excluded exactly when that app isn't in .applications. dev-server
# naturally excludes every GUI app this way, since its Application list
# holds only CLI tools — no separate dev-server branch needed. All three OS-specific paths
# are listed for vscode/zed since personal/dev can be any OS — the OS switch
# above already drops whichever two don't apply to the current Target.
{{ if not (has "wezterm" .applications) }}
.config/wezterm
{{ end }}
{{ if not (has "vscode" .applications) }}
.config/Code
Library/Application Support/Code
AppData/Roaming/Code
{{ end }}
{{ if not (has "zed" .applications) }}
.config/zed
AppData/Roaming/Zed
{{ end }}
{{ if not (has "windows-terminal" .applications) }}
AppData/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe
{{ end }}
{{ if not (has "zen" .applications) }}
.config/zen-profile
{{ end }}
{{ if not (has "iterm2" .applications) }}
Library/Application Support/iTerm2
{{ end }}

# DevPod/devcontainer opt-in (chezmoi init --promptBool devpod=true), narrows
# the managed set to today's install-devpod-dotfiles.sh PACKAGES: git, nvim,
# starship, zsh. Listed on top of whatever the OS switch above already
# excludes (a devpod container is always .chezmoi.os "linux", so Library/
# AppData/Documents are already gone) — only the devpod-specific narrowing
# lives here: no tmux, no GUI-app configs (wezterm/vscode/zed), and no Linux
# Application manifest (a devpod container's Profile still carries GUI apps
# in its Application list — this excludes the manifest itself so
# run_onchange_after_install-linux-applications.sh.tmpl has nothing to
# install; that script is separately gated on `not .devpod` too, since
# excluding the manifest alone would just make it fail trying to read a
# missing file).
{{ if .devpod }}
.psmux.conf
.bashrc
.bash_aliases
.config/tmux
.config/wezterm
.config/Code
.config/zed
.config/apt-packages.txt
.config/yazi
.config/zen-profile
{{ end }}

# Preserves install.sh's SKIP_FILES/SKIP_DIRS behavior: matched by name,
# anywhere in the tree — not just today's specific occurrences.
