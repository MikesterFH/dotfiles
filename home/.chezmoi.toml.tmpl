{{- $profile := promptChoiceOnce . "profile" "Machine profile" (list "personal" "dev" "dev-server") -}}
{{- $devpod := promptBoolOnce . "devpod" "Is this a DevPod/devcontainer" false -}}

{{- /* work identity is used on every profile (personal/dev/dev-server) */ -}}
{{- $workName := promptStringOnce . "git.work.name" "Work git user.name" -}}
{{- $workEmail := promptStringOnce . "git.work.email" "Work git user.email" -}}

{{- /* personal identity: every profile except dev (see docs/adr/0004-machine-profiles.md) */ -}}
{{- $personalName := "" -}}
{{- $personalEmail := "" -}}
{{- if ne $profile "dev" -}}
{{-   $personalName = promptStringOnce . "git.personal.name" "Personal git user.name" -}}
{{-   $personalEmail = promptStringOnce . "git.personal.email" "Personal git user.email" -}}
{{- end -}}

{{- /* client identity: dev profile only */ -}}
{{- $clientName := "" -}}
{{- $clientEmail := "" -}}
{{- if eq $profile "dev" -}}
{{-   $clientName = promptStringOnce . "git.client.name" "Client git user.name" -}}
{{-   $clientEmail = promptStringOnce . "git.client.email" "Client git user.email" -}}
{{- end -}}

{{- /* Application list: per-Profile, platform-agnostic (see
       docs/adr/0006-application-category-and-profile-manifests.md).
       Replaces the five per-app GUI config opt-out prompts from ADR-0004 —
       Profile alone decides the app set now, no per-machine override. A
       machine needing a different set needs a distinct Profile, not a
       prompt answered differently here. */ -}}
{{- /* CLI tools the deployed configs rely on (git's delta pager, the
       starship prompt, tmux plugins' fzf, yazi's previewers, ...) — the
       same on every Profile, dev-server included, see
       docs/adr/0008-cli-tools-are-applications.md. GUI apps vary by
       Profile. */ -}}
{{- $cliTools := list "delta" "starship" "neovim" "tmux" "fzf" "zoxide" "yazi" "glow" "bat" "lazygit" "tree-sitter-cli" "ripgrep" "fd" "unzip" "cmake" "build-tools" -}}
{{- $guiApps := list "wezterm" "vscode" "zed" "windows-terminal" "iterm2" "jetbrains-mono-nerd-font" -}}
{{- $applicationsByProfile := dict
      "personal" (concat $cliTools $guiApps)
      "dev" (concat $cliTools $guiApps)
      "dev-server" $cliTools
-}}
{{- $applications := index $applicationsByProfile $profile -}}

{{- /* Remember where this repo was cloned, so every later chezmoi command
       (apply, update, cd, edit) uses that one working tree instead of the
       default ~/.local/share/chezmoi. workingTree, not sourceDir: sourceDir
       already points into home/ (.chezmoiroot), while chezmoi needs the repo
       root to find .chezmoiroot again. */}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    profile = {{ $profile | quote }}
    devpod = {{ $devpod }}
    applications = [{{ range $i, $app := $applications }}{{ if $i }}, {{ end }}{{ $app | quote }}{{ end }}]

[data.git.work]
    name = {{ $workName | quote }}
    email = {{ $workEmail | quote }}
{{ if ne $profile "dev" }}
[data.git.personal]
    name = {{ $personalName | quote }}
    email = {{ $personalEmail | quote }}
{{ end -}}
{{ if eq $profile "dev" }}
[data.git.client]
    name = {{ $clientName | quote }}
    email = {{ $clientEmail | quote }}
{{ end -}}
