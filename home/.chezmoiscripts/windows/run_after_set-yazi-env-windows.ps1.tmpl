{{- if eq .chezmoi.os "windows" -}}
# Point Yazi at the same ~/.config/yazi every other platform uses, instead of
# its Windows default %APPDATA%\yazi\config, so there's one managed copy.
$yaziConfigHome = Join-Path $HOME ".config\yazi"
[Environment]::SetEnvironmentVariable("YAZI_CONFIG_HOME", $yaziConfigHome, "User")
$env:YAZI_CONFIG_HOME = $yaziConfigHome

$gitCommand = Get-Command git.exe -ErrorAction SilentlyContinue
$candidates = @()

if ($gitCommand) {
    $gitRoot = Split-Path (Split-Path $gitCommand.Source -Parent) -Parent
    $candidates += Join-Path $gitRoot "usr\bin\file.exe"
}

$candidates += @(
    (Join-Path $env:ProgramFiles "Git\usr\bin\file.exe"),
    (Join-Path $env:LOCALAPPDATA "Programs\Git\usr\bin\file.exe"),
    (Join-Path $HOME "scoop\apps\git\current\usr\bin\file.exe")
)

$fileOne = $candidates |
    Where-Object { Test-Path -LiteralPath $_ -PathType Leaf } |
    Select-Object -First 1

if (-not $fileOne) {
    throw "Yazi needs Git for Windows' file.exe. Install Git for Windows, then apply dotfiles again."
}

[Environment]::SetEnvironmentVariable("YAZI_FILE_ONE", $fileOne, "User")
$env:YAZI_FILE_ONE = $fileOne

$gitRoot = Split-Path (Split-Path (Split-Path $fileOne -Parent) -Parent) -Parent
$shellDir = Join-Path $gitRoot "bin"
if (-not (Test-Path -LiteralPath (Join-Path $shellDir "sh.exe") -PathType Leaf)) {
    throw "Yazi's Piper plugin needs Git for Windows' bin\sh.exe. Repair your Git installation."
}

function Add-UserPath {
    param([string]$Dir)
    $userPath = [Environment]::GetEnvironmentVariable("Path", "User")
    if (($userPath -split ";" | ForEach-Object { $_.TrimEnd("\") }) -notcontains $Dir.TrimEnd("\")) {
        [Environment]::SetEnvironmentVariable("Path", ($userPath.TrimEnd(";") + ";" + $Dir), "User")
    }
    if (($env:Path -split ";" | ForEach-Object { $_.TrimEnd("\") }) -notcontains $Dir.TrimEnd("\")) {
        $env:Path += ";" + $Dir
    }
}

Add-UserPath $shellDir

# Previewer tools whose installers don't reliably put them on the PATH (see
# docs/adr/0014-yazi-previews-on-every-platform.md): the 7-Zip installer
# never does, ImageMagick's only when its "add to path" task ran. Skipped
# when the tool is already found or isn't installed at all.
if (-not (Get-Command 7z -ErrorAction SilentlyContinue)) {
    $sevenZipDir = Join-Path $env:ProgramFiles "7-Zip"
    if (Test-Path -LiteralPath (Join-Path $sevenZipDir "7z.exe") -PathType Leaf) {
        Add-UserPath $sevenZipDir
    }
}
if (-not (Get-Command magick -ErrorAction SilentlyContinue)) {
    $magickDir = Get-ChildItem -Path $env:ProgramFiles -Directory -Filter "ImageMagick-*" -ErrorAction SilentlyContinue |
        Sort-Object Name -Descending |
        Where-Object { Test-Path -LiteralPath (Join-Path $_.FullName "magick.exe") -PathType Leaf } |
        Select-Object -First 1
    if ($magickDir) {
        Add-UserPath $magickDir.FullName
    }
}
{{- end -}}
