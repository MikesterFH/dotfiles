{{- if eq .chezmoi.os "windows" -}}
# =============================================================================
# chezmoi run_once_before script: installs prerequisite Bootstrap Packages
# (PowerShell 7, git, mise, psmux) via winget before any managed dotfiles are
# applied. PowerShell 7 (pwsh) is included because the deployed profile
# (Documents/PowerShell/Microsoft.PowerShell_profile.ps1) is the pwsh
# profile path — Windows PowerShell 5.1 ships by default but never reads it.
# psmux (github.com/psmux/psmux) gives native Windows a tmux-compatible
# multiplexer that reads the same tmux.conf as macOS/Linux — see
# docs/adr/0005-psmux-for-windows-tmux-parity.md. Like the other Bootstrap
# Packages, it's installed unconditionally, independent of `profile`.
#
# Windows Target only — no Docker step here, nor in the macOS/Linux sibling;
# Docker is intentionally not installed by this workflow on any Target.
# Sibling run_once_before_install-packages.sh.tmpl handles macOS/Linux/WSL
# and renders empty on Windows, so only one of the two ever actually runs.
# =============================================================================
$ErrorActionPreference = "Stop"

function Test-CommandExists {
    param([string]$Command)
    return [bool](Get-Command $Command -ErrorAction SilentlyContinue)
}

function Ensure-WingetPackage {
    param(
        [string]$Command,
        [string]$Id,
        [string]$DisplayName
    )
    Write-Host "[INFO]  Checking $DisplayName..."
    if (Test-CommandExists $Command) {
        Write-Host "[OK]    $DisplayName already installed ($(& $Command --version))"
        return
    }
    Write-Host "[INFO]  Installing $DisplayName..."
    winget install --id $Id -e --source winget --accept-package-agreements --accept-source-agreements
    if (Test-CommandExists $Command) {
        Write-Host "[OK]    $DisplayName installed ($(& $Command --version))"
    } else {
        Write-Warning "$DisplayName installed but not yet available in this shell session. Restart your terminal."
    }
}

Ensure-WingetPackage -Command "pwsh" -Id "Microsoft.PowerShell" -DisplayName "PowerShell 7"
Ensure-WingetPackage -Command "git" -Id "Git.Git" -DisplayName "git"
Ensure-WingetPackage -Command "mise" -Id "jdx.mise" -DisplayName "mise"
Ensure-WingetPackage -Command "psmux" -Id "marlocarlo.psmux" -DisplayName "psmux"

{{- end -}}
