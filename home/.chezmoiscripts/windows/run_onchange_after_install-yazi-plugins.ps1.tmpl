{{- if eq .chezmoi.os "windows" -}}
# =============================================================================
# chezmoi run_onchange_after script: installs the Yazi plugins pinned in
# ~/.config/yazi/package.toml via `ya pkg install`. Windows sibling of
# unix/run_onchange_after_install-yazi-plugins.sh.tmpl.
#
# Rerun trigger: hash of package.toml, so a new or re-pinned plugin is
# installed on the next `chezmoi apply`.
# package.toml sha256: {{ include "dot_config/yazi/package.toml" | sha256sum }}
#
# Sorts after install-mise-tools (yazi installed) but before
# set-yazi-env-windows, so YAZI_CONFIG_HOME is set here for this process too.
# =============================================================================
$ErrorActionPreference = "Stop"

$env:YAZI_CONFIG_HOME = Join-Path $HOME ".config\yazi"

# yazi is a mise tool (docs/adr/0023-applications-from-one-data-file.md);
# mise installed it in a sibling process this apply, and no profile has
# activated mise here, so put its shims first. Machine/User PATH is re-read
# for mise itself, which winget may have just installed.
$env:Path = (Join-Path $env:LOCALAPPDATA "mise\shims") + ";" +
    [Environment]::GetEnvironmentVariable("Path", "Machine") + ";" +
    [Environment]::GetEnvironmentVariable("Path", "User")

# Fail rather than skip: a run_onchange script that exits 0 is recorded as
# done and never reruns until package.toml changes.
if (-not (Get-Command ya -ErrorAction SilentlyContinue)) {
    Write-Error "yazi (ya) not installed; cannot install Yazi plugins."
    exit 1
}

Write-Host "[INFO]  Installing Yazi plugins..."
ya pkg install
if ($LASTEXITCODE -ne 0) {
    Write-Error "ya pkg install failed (exit code $LASTEXITCODE)"
    exit 1
}
Write-Host "[OK]    Yazi plugins installed."
{{- end -}}
