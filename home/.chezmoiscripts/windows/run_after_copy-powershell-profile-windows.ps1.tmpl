{{- if eq .chezmoi.os "windows" -}}
# =============================================================================
# PowerShell reads its profile from the real Documents folder, which OneDrive
# folder redirection can move away from ~\Documents (e.g. to
# ~\OneDrive - <Org>\Documents). chezmoi always deploys to ~\Documents, so this
# script copies the profile to the redirected location after every apply.
# Nothing to do when Documents is not redirected.
# =============================================================================
$source = Join-Path $HOME "Documents\PowerShell\Microsoft.PowerShell_profile.ps1"
$documents = [Environment]::GetFolderPath("MyDocuments")
$dest = Join-Path $documents "PowerShell\Microsoft.PowerShell_profile.ps1"

if ((Test-Path $source) -and ($source -ne $dest)) {
    New-Item -ItemType Directory -Force -Path (Split-Path $dest) | Out-Null
    Copy-Item -Force $source $dest
}
{{- end -}}
