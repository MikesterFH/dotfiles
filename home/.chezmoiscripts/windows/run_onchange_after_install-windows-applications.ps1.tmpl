{{- if eq .chezmoi.os "windows" -}}
# =============================================================================
# chezmoi run_onchange_after script: installs the current Profile's Windows
# Application list via `winget import`, reading the manifest rendered by
# dot_config/winget/packages.json.tmpl from the Application list computed
# in .chezmoi.toml.tmpl. See
# docs/adr/0006-application-category-and-profile-manifests.md.
#
# `run_onchange_` (not `run_once_`) so editing the Profile's Application list
# and re-running `chezmoi apply` reaches an already-provisioned machine, not
# only a fresh install — the "manifest sha256" comment below is what changes
# the rendered script's content, and therefore its re-run hash, whenever the
# rendered manifest changes.
#
# `_after_` so this always runs once every Managed File — including the
# manifest itself — has already been written. No Bootstrap-installed
# package manager is required first: winget ships with Windows already.
#
# No separate devpod exclusion needed here (unlike the Linux Application
# script) — devpod is always .chezmoi.os "linux", so this Windows-only
# script can never run in a devpod context in the first place.
#
# Rerun trigger: hash of the rendered manifest, so a changed package
# identifier reruns this script too, not only a changed Application list.
# manifest sha256: {{ includeTemplate "dot_config/winget/packages.json.tmpl" . | sha256sum }}
# =============================================================================
$ErrorActionPreference = "Stop"

$manifest = Join-Path $HOME ".config\winget\packages.json"

Write-Host "[INFO]  Installing Windows Applications via winget import..."
# --ignore-unavailable: a package ID winget can't find is reported and
# skipped instead of aborting the rest of the import.
winget import --import-file $manifest --ignore-unavailable --accept-package-agreements --accept-source-agreements
$failed = $LASTEXITCODE -ne 0
{{- if has "build-tools" .applications }}

# build-tools: the MSVC compiler nvim-treesitter's `tree-sitter build` needs
# (the cc crate finds it through vswhere, no Developer Prompt required).
# Not in the manifest because the bare package installs no workload; skip
# when a VC toolset is already present so a rerun doesn't reconfigure VS.
$vswhere = Join-Path ${env:ProgramFiles(x86)} "Microsoft Visual Studio\Installer\vswhere.exe"
$hasVcTools = (Test-Path $vswhere) -and (& $vswhere -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath)
if ($hasVcTools) {
    Write-Host "[OK]    MSVC build tools already installed."
} else {
    Write-Host "[INFO]  Installing Visual Studio Build Tools (C++ workload)..."
    winget install --id Microsoft.VisualStudio.2022.BuildTools -e --source winget --accept-package-agreements --accept-source-agreements `
        --override "--quiet --wait --norestart --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended"
    if ($LASTEXITCODE -ne 0) { $failed = $true }
}
{{- end }}
if ($failed) {
    Write-Host "[WARN]  Some Windows Applications failed to install (see above)."
} else {
    Write-Host "[OK]    Windows Applications installed."
}
{{- end -}}
