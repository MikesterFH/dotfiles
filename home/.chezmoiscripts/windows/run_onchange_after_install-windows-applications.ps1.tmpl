{{- if eq .chezmoi.os "windows" -}}
# =============================================================================
# chezmoi run_onchange_after script: installs the current Profile's Windows
# Application list via `winget import`, reading the manifest rendered by
# dot_config/winget/packages.json.tmpl from the Application list computed
# in .chezmoi.toml.tmpl. See
# docs/adr/0006-application-category-and-profile-manifests.md.
#
# `run_onchange_` (not `run_once_`) so editing the Profile's Application list
# and re-running `chezmoi apply` reaches an already-provisioned machine, not
# only a fresh install — the "applications" comment below is what changes
# the rendered script's content, and therefore its re-run hash, whenever the
# resolved list changes.
#
# `_after_` so this always runs once every Managed File — including the
# manifest itself — has already been written. No Bootstrap-installed
# package manager is required first: winget ships with Windows already.
#
# No separate devpod exclusion needed here (unlike the Linux Application
# script) — devpod is always .chezmoi.os "linux", so this Windows-only
# script can never run in a devpod context in the first place.
#
# applications: {{ .applications | join "," }}
# =============================================================================
$ErrorActionPreference = "Stop"

$manifest = Join-Path $HOME ".config\winget\packages.json"

Write-Host "[INFO]  Installing Windows Applications via winget import..."
winget import --import-file $manifest --accept-package-agreements --accept-source-agreements
Write-Host "[OK]    Windows Applications installed."
{{- end -}}
