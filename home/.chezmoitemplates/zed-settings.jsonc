// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `zed: Open Default Settings` command
// from the command palette
{
  "cli_default_open_behavior": "new_window",
  "agent_buffer_font_size": 12.0,
  "agent_ui_font_size": 12.0,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "model": "sonnet"
      },
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "disable_ai": false,
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "confirm_quit": false,

  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "scrollbar": {
    "show": "never"
  },
  "buffer_line_height": {
    "custom": 1.7
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 12.0,
    "line_height": {
      "custom": 1.7
    }
  },
  "inlay_hints": {
    "enabled": false
  },

  // LSP hover: mouse after hover_popover_delay ms, or `shift-k` / `g h` in
  // vim normal mode. While it's open, ctrl-e/ctrl-y (line), ctrl-d/ctrl-u
  // (half page) and ctrl-f/ctrl-b (page) scroll the popover instead of the
  // buffer. Sticky keeps it open while the mouse moves into it.
  "hover_popover_enabled": true,
  "hover_popover_delay": 300,
  "hover_popover_sticky": true,
  // Show parameter info while typing a call's arguments.
  "auto_signature_help": true,

  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 12.0,
  "buffer_font_size": 12.0,

  "autosave": "on_focus_change",

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "GitHub Dark"
  },
  "languages": {
    "C++": {
      "enable_language_server": true,
      "use_autoclose": true,
      "extend_comment_on_newline": true,
      "remove_trailing_whitespace_on_save": true,
      "tab_size": 4,
      "indent_size": 4,
      "indent_style": "space",
      "code_actions_on_format": {
        "clangd": true
      },
      "always_treat_brackets_as_autoclosed": true,
      "ensure_final_newline_on_save": true,
      "show_copilot_suggestions": true
    },
    "C": {
      "show_copilot_suggestions": true,
      "enable_language_server": true,
      "use_autoclose": true,
      "extend_comment_on_newline": true,
      "remove_trailing_whitespace_on_save": true,
      "code_actions_on_format": {
        "clangd": true
      },
      "always_treat_brackets_as_autoclosed": true,
      "ensure_final_newline_on_save": true
    },
    "Rust": {
      "enable_language_server": true,
      "use_autoclose": true,
      "extend_comment_on_newline": true,
      "remove_trailing_whitespace_on_save": true,
      "code_actions_on_format": {
        "rust-analyzer": true
      },
      "always_treat_brackets_as_autoclosed": true,
      "ensure_final_newline_on_save": true,
      "show_copilot_suggestions": true
    }
  },
  // merged from local Windows machine
  "diff_view_style": "split",
  "which_key": {
    "enabled": true
  },
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "VSCode",
  "sticky_scroll": {
    "enabled": false
  },
  "vertical_scroll_margin": 8.0,
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "always"
  },
  "colorize_brackets": true,
}
