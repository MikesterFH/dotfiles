{{- /* German spell files for Neovim (options.lua sets spelllang = de,en).
       Neovim only fetches missing spell files through its spellfile plugin,
       which needs netrw, and LazyVim disables netrw, so they are pulled in
       here instead. See docs/adr/0010-nvim-spell-files-as-chezmoi-externals.md. */ -}}
{{- if has "neovim" .applications }}
{{-   $spellDir := ".local/share/nvim/site/spell" }}
{{-   if eq .chezmoi.os "windows" }}{{ $spellDir = "AppData/Local/nvim-data/site/spell" }}{{ end }}
{{-   range list "de.utf-8.spl" "de.utf-8.sug" }}

["{{ $spellDir }}/{{ . }}"]
    type = "file"
    url = "https://ftp.nluug.nl/pub/vim/runtime/spell/{{ . }}"
    refreshPeriod = "2160h"
{{-   end }}
{{- end }}

{{- /* JetBrainsMono Nerd Font on Linux, the font wezterm, zed and the nvim
       icons expect. macOS and Windows install it as an Application through
       the Brewfile cask / winget manifest; apt has no Nerd Font package, so
       it comes from the Nerd Fonts release here. fontconfig picks up the new
       directory under ~/.local/share/fonts on its own. Not in devpod, which
       has no display. See docs/adr/0011-nvim-toolchain.md. */ -}}
{{- if and (eq .chezmoi.os "linux") (has "jetbrains-mono-nerd-font" .applications) (not .devpod) }}

[".local/share/fonts/JetBrainsMonoNerdFont"]
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.tar.xz"
    exact = true
    refreshPeriod = "2160h"
{{- end }}

{{- /* oh-my-zsh for .zshrc on macOS and Linux (no zsh on Windows), see
       docs/adr/0015-default-shells.md. A git-repo external: chezmoi clones
       it once and `git pull`s it every refreshPeriod, so an existing clone
       and its custom/ dir stay as they are. oh-my-zsh's own updater is off
       in .zshrc, since chezmoi does the pulling. */ -}}
{{- if ne .chezmoi.os "windows" }}

[".oh-my-zsh"]
    type = "git-repo"
    url = "https://github.com/ohmyzsh/ohmyzsh.git"
    refreshPeriod = "168h"
    [".oh-my-zsh".clone]
        args = ["--depth", "1"]
    [".oh-my-zsh".pull]
        args = ["--ff-only"]
{{- end }}
