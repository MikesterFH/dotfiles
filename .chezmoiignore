# Per-OS paths, one switch on .chezmoi.os for everything that differs by
# Target: vscode's settings live at a different real path per OS (macOS:
# Library/, Linux: .config/Code, Windows: AppData); the iTerm2 Dynamic
# Profile (Library/) and PowerShell profile (Documents/) are single-OS only;
# zed lives at .config/zed everywhere except Windows (AppData/Roaming/Zed);
# and the Windows Target has no shells of its own (no bash/zsh/tmux there).
# Every branch lists everything *not* relevant to that OS, so an unlisted
# fifth OS falls through to the catch-all and excludes all of it — fail
# safe, not a guess.
{{ if eq .chezmoi.os "darwin" }}
.config/Code
AppData
Documents
{{ else if eq .chezmoi.os "linux" }}
Library
AppData
Documents
{{ else if eq .chezmoi.os "windows" }}
Library
.config/Code
.bashrc
.bash_aliases
.zshrc
.zprofile
.zsh_aliases
.config/tmux
.config/zed
{{ else }}
Library
.config/Code
AppData
Documents
{{ end }}

# DevPod/devcontainer opt-in (chezmoi init --promptBool devpod=true), narrows
# the managed set to today's install-devpod-dotfiles.sh PACKAGES: git, nvim,
# starship, zsh. Listed on top of whatever the OS switch above already
# excludes (a devpod container is always .chezmoi.os "linux", so Library/
# AppData/Documents are already gone) — only the devpod-specific narrowing
# lives here: no tmux, no GUI-app configs (wezterm/vscode/zed).
{{ if .devpod }}
.bashrc
.bash_aliases
.config/tmux
.config/wezterm
.config/Code
.config/zed
{{ end }}

