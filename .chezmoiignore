# Per-OS paths, one switch on .chezmoi.os for everything that differs by
# Target: vscode's settings live at a different real path per OS (macOS:
# Library/, Linux: .config/Code, Windows: AppData); the iTerm2 Dynamic
# Profile (Library/) and PowerShell profile (Documents/) are single-OS only;
# zed lives at .config/zed everywhere except Windows (AppData/Roaming/Zed);
# and the Windows Target has no bash/zsh of its own. tmux IS deployed on
# Windows (.config/tmux is not excluded there) — psmux reads the same
# tmux.conf, see docs/adr/0005-psmux-for-windows-tmux-parity.md.
# Every branch lists everything *not* relevant to that OS, so an unlisted
# fifth OS falls through to the catch-all and excludes all of it — fail
# safe, not a guess.
{{ if eq .chezmoi.os "darwin" }}
.config/Code
AppData
Documents
{{ else if eq .chezmoi.os "linux" }}
Library
AppData
Documents
{{ else if eq .chezmoi.os "windows" }}
Library
.config/Code
.bashrc
.bash_aliases
.zshrc
.zprofile
.zsh_aliases
.config/zed
{{ else }}
Library
.config/Code
AppData
Documents
{{ end }}

# Machine Profile (chezmoi init --promptChoiceOnce profile=personal|dev|dev-server,
# see docs/adr/0004-machine-profiles.md): narrows which git identity
# config.local.* files exist to match which [data.git.*] tables
# .chezmoi.toml.tmpl actually populated for the chosen profile — dev never
# gets a personal identity, only dev gets a client identity. work is
# generated on every profile, so it's never excluded here.
{{ if eq .profile "dev" }}
.config/git/config.local.personal
{{ else }}
.config/git/config.local.client
{{ end }}

# GUI-app configs (per-Profile Application list, see .chezmoi.toml.tmpl and
# docs/adr/0006-application-category-and-profile-manifests.md): each app's
# config is excluded exactly when that app isn't in .applications. dev-server
# naturally excludes every GUI app this way, since its Application list is
# empty — no separate dev-server branch needed. All three OS-specific paths
# are listed for vscode/zed since personal/dev can be any OS — the OS switch
# above already drops whichever two don't apply to the current Target.
{{ if not (has "wezterm" .applications) }}
.config/wezterm
{{ end }}
{{ if not (has "vscode" .applications) }}
.config/Code
Library/Application Support/Code
AppData/Roaming/Code
{{ end }}
{{ if not (has "zed" .applications) }}
.config/zed
AppData/Roaming/Zed
{{ end }}
{{ if not (has "windows-terminal" .applications) }}
AppData/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe
{{ end }}
{{ if not (has "iterm2" .applications) }}
Library/Application Support/iTerm2
{{ end }}

# DevPod/devcontainer opt-in (chezmoi init --promptBool devpod=true), narrows
# the managed set to today's install-devpod-dotfiles.sh PACKAGES: git, nvim,
# starship, zsh. Listed on top of whatever the OS switch above already
# excludes (a devpod container is always .chezmoi.os "linux", so Library/
# AppData/Documents are already gone) — only the devpod-specific narrowing
# lives here: no tmux, no GUI-app configs (wezterm/vscode/zed).
{{ if .devpod }}
.bashrc
.bash_aliases
.config/tmux
.config/wezterm
.config/Code
.config/zed
{{ end }}

