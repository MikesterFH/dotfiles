# =============================================================================
# Git Configuration (public / shared)
#
# Identity is set per directory via includeIf. The corresponding
# config.local.* files are generated by chezmoi from the name/email you gave
# `chezmoi init` — not tracked by the dotfiles repo, no manual setup needed.
# =============================================================================

# Personal projects (~/dev/personal/)
[includeIf "gitdir:~/dev/personal/"]
	path = config.local.personal

# Employer projects (~/dev/work/)
[includeIf "gitdir:~/dev/work/"]
	path = config.local.work

# Client projects (~/dev/client/)
[includeIf "gitdir:~/dev/client/"]
	path = config.local.client

[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = {{ if eq .chezmoi.os "windows" }}true{{ else }}input{{ end }}
	pager = delta

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[rebase]
	autoStash = true

[rerere]
	enabled = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true

[alias]
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
