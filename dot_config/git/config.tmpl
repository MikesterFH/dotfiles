# =============================================================================
# Git Configuration (public / shared)
#
# Identity is set per directory via includeIf. The corresponding
# config.local.* files are generated by chezmoi from the name/email you gave
# `chezmoi init` — not tracked by the dotfiles repo, no manual setup needed.
# Which identities exist at all depends on the `profile` you chose at init
# (see docs/adr/0004-machine-profiles.md) — the includeIf blocks below only
# appear for identities that profile actually generates.
# =============================================================================

# Personal projects (~/dev/personal/) — every profile except dev
{{- if ne .profile "dev" }}
[includeIf "gitdir:~/dev/personal/"]
	path = config.local.personal
{{- end }}

# Employer projects (~/dev/work/) — every profile
[includeIf "gitdir:~/dev/work/"]
	path = config.local.work

# Client projects (~/dev/client/) — dev profile only
{{- if eq .profile "dev" }}
[includeIf "gitdir:~/dev/client/"]
	path = config.local.client
{{- end }}

[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = {{ if eq .chezmoi.os "windows" }}true{{ else }}input{{ end }}
	pager = delta

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[rebase]
	autoStash = true

[rerere]
	enabled = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true

[alias]
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
