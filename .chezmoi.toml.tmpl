{{- $profile := promptChoiceOnce . "profile" "Machine profile" (list "personal" "dev" "dev-server") -}}
{{- $devpod := promptBoolOnce . "devpod" "Is this a DevPod/devcontainer" false -}}

{{- /* work identity is used on every profile (personal/dev/dev-server) */ -}}
{{- $workName := promptStringOnce . "git.work.name" "Work git user.name" -}}
{{- $workEmail := promptStringOnce . "git.work.email" "Work git user.email" -}}

{{- /* personal identity: every profile except dev (see docs/adr/0004-machine-profiles.md) */ -}}
{{- $personalName := "" -}}
{{- $personalEmail := "" -}}
{{- if ne $profile "dev" -}}
{{-   $personalName = promptStringOnce . "git.personal.name" "Personal git user.name" -}}
{{-   $personalEmail = promptStringOnce . "git.personal.email" "Personal git user.email" -}}
{{- end -}}

{{- /* client identity: dev profile only */ -}}
{{- $clientName := "" -}}
{{- $clientEmail := "" -}}
{{- if eq $profile "dev" -}}
{{-   $clientName = promptStringOnce . "git.client.name" "Client git user.name" -}}
{{-   $clientEmail = promptStringOnce . "git.client.email" "Client git user.email" -}}
{{- end -}}

{{- /* GUI-app config opt-out: personal/dev only, one prompt per app, only
       when the app applies to this OS. dev-server never prompts here — it
       never gets GUI configs regardless (see .chezmoiignore) — so these
       just keep their true default, unused. */ -}}
{{- $weztermConfig := true -}}
{{- $vscodeConfig := true -}}
{{- $zedConfig := true -}}
{{- $windowsTerminalConfig := true -}}
{{- $iterm2Config := true -}}
{{- if ne $profile "dev-server" -}}
{{-   $weztermConfig = promptBoolOnce . "weztermConfig" "Deploy wezterm config" true -}}
{{-   $vscodeConfig = promptBoolOnce . "vscodeConfig" "Deploy VS Code config" true -}}
{{-   $zedConfig = promptBoolOnce . "zedConfig" "Deploy Zed config" true -}}
{{-   if eq .chezmoi.os "windows" -}}
{{-     $windowsTerminalConfig = promptBoolOnce . "windowsTerminalConfig" "Deploy Windows Terminal config" true -}}
{{-   end -}}
{{-   if eq .chezmoi.os "darwin" -}}
{{-     $iterm2Config = promptBoolOnce . "iterm2Config" "Deploy iTerm2 config" true -}}
{{-   end -}}
{{- end -}}

[data]
    profile = {{ $profile | quote }}
    devpod = {{ $devpod }}
    weztermConfig = {{ $weztermConfig }}
    vscodeConfig = {{ $vscodeConfig }}
    zedConfig = {{ $zedConfig }}
    windowsTerminalConfig = {{ $windowsTerminalConfig }}
    iterm2Config = {{ $iterm2Config }}

[data.git.work]
    name = {{ $workName | quote }}
    email = {{ $workEmail | quote }}
{{ if ne $profile "dev" }}
[data.git.personal]
    name = {{ $personalName | quote }}
    email = {{ $personalEmail | quote }}
{{ end -}}
{{ if eq $profile "dev" }}
[data.git.client]
    name = {{ $clientName | quote }}
    email = {{ $clientEmail | quote }}
{{ end -}}
